P6MCP_WORKSPACE_DIRS=/path/to/xer/files
P6MCP_OUTPUT_DIR=/tmp/p6mcp_output
P6MCP_ENABLE_MUTATION=false
P6MCP_AUTH_TOKEN=
P6MCP_LOG_JSON=false
P6MCP_CACHE_SIZE=10
P6MCP_MAX_RESPONSE_BYTES=5000000
